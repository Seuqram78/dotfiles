#!/usr/bin/env bash
set -euo pipefail

profiles="{{ .chezmoi.sourceDir }}/profiles"
layers="$profiles/base $profiles/{{ .profile }}"

for layer in $layers; do
    if [ ! -d "$layer" ]; then
{{- $known := list }}
{{- range (glob (printf "%s/profiles/*" .chezmoi.sourceDir)) }}
{{-   $known = append $known (base .) }}
{{- end }}
        printf '%s\n' "Profile directory $layer does not exist." >&2
        printf '%s\n' "Known profiles: {{ join ", " (sortAlpha $known) }}" >&2
        printf '%s\n' 'Fix the profile value in ~/.config/chezmoi/chezmoi.toml.' >&2
        exit 1
    fi
done

load_brew() {
    if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
    elif [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv bash)"
    elif [ -x /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv bash)"
    fi
}

if command -v apt >/dev/null 2>&1; then
    sudo apt update
    sudo apt install -y software-properties-common
    sudo add-apt-repository -y ppa:git-core/ppa
    sudo apt update
    sudo apt install -y build-essential bubblewrap curl file git procps

    for layer in $layers; do
        [ -f "$layer/apt.txt" ] || continue
        xargs -r sudo apt install -y <"$layer/apt.txt"
    done
fi

load_brew

if ! command -v brew >/dev/null 2>&1; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

load_brew

if ! command -v brew >/dev/null 2>&1; then
    printf '%s\n' 'Homebrew installation completed, but brew is not available on PATH.' >&2
    exit 1
fi

brew trust --tap kiki-ki/tap

for layer in $layers; do
    [ -f "$layer/Brewfile" ] || continue
    brew bundle --file "$layer/Brewfile"
done
