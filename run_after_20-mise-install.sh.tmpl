#!/usr/bin/env bash
set -euo pipefail

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv bash)"
fi

profile_dir="{{ .chezmoi.sourceDir }}/profiles/{{ .profile }}"

if command -v mise >/dev/null 2>&1; then
    mise install
else
    printf '%s\n' 'mise is not available; package installation did not complete successfully.' >&2
    exit 1
fi

eval "$(mise activate bash)"

if command -v npm >/dev/null 2>&1; then
    xargs -r npm install -g <"{{ .chezmoi.sourceDir }}/packages/npm.txt"

    if [ -f "$profile_dir/npm.txt" ]; then
        xargs -r npm install -g <"$profile_dir/npm.txt"
    fi
else
    printf '%s\n' 'npm is not available after mise install; Node installation did not complete successfully.' >&2
    exit 1
fi

if command -v uv >/dev/null 2>&1; then
    for uv_list in "{{ .chezmoi.sourceDir }}/packages/uv.txt" "$profile_dir/uv.txt"; do
        [ -f "$uv_list" ] || continue

        while IFS= read -r package || [ -n "$package" ]; do
            [ -n "$package" ] || continue
            uv tool install "$package"
        done <"$uv_list"
    done
else
    printf '%s\n' 'uv is not available; Homebrew package installation did not complete successfully.' >&2
    exit 1
fi
