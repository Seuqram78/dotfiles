#!/usr/bin/env bash
set -euo pipefail

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv bash)"
fi

profiles="{{ .chezmoi.sourceDir }}/profiles"
layers="$profiles/base{{ if ne .profile "base" }} $profiles/{{ .profile }}{{ end }}"

if command -v mise >/dev/null 2>&1; then
    mise install
else
    printf '%s\n' 'mise is not available; package installation did not complete successfully.' >&2
    exit 1
fi

eval "$(mise activate bash)"

if command -v npm >/dev/null 2>&1; then
    for layer in $layers; do
        [ -f "$layer/npm.txt" ] || continue
        xargs -r npm install -g <"$layer/npm.txt"
    done
else
    printf '%s\n' 'npm is not available after mise install; Node installation did not complete successfully.' >&2
    exit 1
fi

if command -v uv >/dev/null 2>&1; then
    for layer in $layers; do
        [ -f "$layer/uv.txt" ] || continue

        while IFS= read -r package || [ -n "$package" ]; do
            [ -n "$package" ] || continue
            uv tool install "$package"
        done <"$layer/uv.txt"
    done
else
    printf '%s\n' 'uv is not available; Homebrew package installation did not complete successfully.' >&2
    exit 1
fi

if command -v cargo >/dev/null 2>&1; then
    for layer in $layers; do
        [ -f "$layer/cargo.txt" ] || continue

        while IFS= read -r package || [ -n "$package" ]; do
            [ -n "$package" ] || continue
            cargo install "$package"
        done <"$layer/cargo.txt"
    done
else
    printf '%s\n' 'cargo is not available after mise install; Rust installation did not complete successfully.' >&2
    exit 1
fi
