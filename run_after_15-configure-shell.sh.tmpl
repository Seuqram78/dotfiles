#!/usr/bin/env bash
set -euo pipefail

bashrc="$HOME/.bashrc"
touch "$bashrc"

if grep -q '^# chezmoi dotfiles shell setup$' "$bashrc"; then
    if grep -q '^# chezmoi dotfiles shell setup end$' "$bashrc"; then
        sed -i '/^# chezmoi dotfiles shell setup$/,/^# chezmoi dotfiles shell setup end$/d' "$bashrc"
    else
        sed -i '/^# chezmoi dotfiles shell setup$/,$d' "$bashrc"
    fi
fi

cat >>"$bashrc" <<'EOF'

# chezmoi dotfiles shell setup
export EDITOR=nvim

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
    export LD_LIBRARY_PATH="/home/linuxbrew/.linuxbrew/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
    export LD_LIBRARY_PATH="/opt/homebrew/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv bash)"
    export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

if [ -f "$HOME/.bash_aliases" ]; then
    . "$HOME/.bash_aliases"
fi

if [ -f "$HOME/.bash_functions" ]; then
    . "$HOME/.bash_functions"
fi

if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if [ -s /opt/adguard-cli/bash-completion.sh ]; then
    . /opt/adguard-cli/bash-completion.sh
fi
# chezmoi dotfiles shell setup end
EOF
