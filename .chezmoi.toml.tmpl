{{- /* Valid profiles are the directories under profiles/. Choosing base means
       no machine-specific extras. Adding a directory adds a choice. */ -}}
{{- $choices := list -}}
{{- range (glob (printf "%s/profiles/*" .chezmoi.sourceDir)) -}}
{{-   $choices = append $choices (base .) -}}
{{- end -}}
{{- $choices = sortAlpha $choices -}}
{{- $default := "personal" -}}
{{- if not (has $default $choices) -}}
{{-   $default = "base" -}}
{{- end -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" $choices $default -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o022

[data]
    profile = {{ $profile | quote }}
