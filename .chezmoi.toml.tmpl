{{- /* Valid profiles are the directories under profiles/, except base, which
       every machine gets. Adding a directory adds a choice. */ -}}
{{- $choices := list -}}
{{- range (glob (printf "%s/profiles/*" .chezmoi.sourceDir)) -}}
{{-   $name := base . -}}
{{-   if ne $name "base" -}}
{{-     $choices = append $choices $name -}}
{{-   end -}}
{{- end -}}
{{- $choices = sortAlpha $choices -}}
{{- $default := "personal" -}}
{{- if not (has $default $choices) -}}
{{-   $default = first $choices -}}
{{- end -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" $choices $default -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o022

[data]
    profile = {{ $profile | quote }}
